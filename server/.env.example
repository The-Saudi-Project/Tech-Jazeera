# ==============================================================================
# Server environment variables
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# Every variable listed here is validated at boot by src/config/env.js —
# the server refuses to start if one is missing or malformed.
# ==============================================================================

# 'development' or 'production'. Controls log format and error verbosity.
NODE_ENV=development

# Port the API listens on.
PORT=5000

# MongoDB Atlas connection string.
# Format: mongodb+srv://<user>:<password>@<cluster-host>/<database>?retryWrites=true&w=majority
MONGODB_URI=YOUR_MONGODB_URI_HERE

# Origin of the React app, used for CORS. The Vite dev server default is below.
CLIENT_URL=http://localhost:5173

# Copy this file to .env and fill in real values. .env is gitignored —
# never commit real credentials.

# Base URL of the CRM API, including the /api prefix. This is the project's
# real production URL (see docs/P-MOBILE-notes.md) — point this at
# http://localhost:5000/api instead while developing/testing this bridge.
CRM_API_BASE=https://techjazeera.duckdns.org/api

# A DEDICATED login for this bridge — do not reuse a real person's own
# account. Every read this server makes is attributed to this login in the
# CRM's own audit log, so a dedicated service account keeps that log
# meaningful (and lets you disable just this one login later without
# locking out a real person). Recommended: a full Admin login, created
# specifically for this bridge, used for nothing else.
CRM_SERVICE_EMAIL=
CRM_SERVICE_PASSWORD=

# Optional: a pre-existing access token, used until it expires (access
# tokens on this CRM last 15 minutes). Saves one login round trip on
# startup — entirely optional, since CRM_SERVICE_EMAIL/PASSWORD above are
# used automatically the moment any request gets a 401. Leave blank to
# always start from a fresh login.
CRM_SERVICE_TOKEN=
